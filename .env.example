APP_NAME="Mkhaya Agri"
# Use "production" on live servers (also disables demo-data seeding).
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Demo/sample data (org structure, sample employees, fleet…) on `db:seed`.
# Defaults to on when APP_ENV != production. Set false on live to guarantee a
# clean seed even if APP_ENV is mistakenly "local".
SEED_DEMO_DATA=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
AUTH_INACTIVITY_TIMEOUT=15
AUTH_INACTIVITY_FLUSH_SESSION=true

# ── Azure Active Directory (governance SSO) ───────────────────────────────────
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI="${APP_URL}/auth/azure/callback"
# Set to true to auto-create intranet accounts for Azure AD users on first login
AZURE_AUTO_PROVISION=false

# ── Governance module ──────────────────────────────────────────────────────────
# Inactivity timeout for governance routes (minutes, overrides AUTH_INACTIVITY_TIMEOUT)
GOVERNANCE_SESSION_TIMEOUT=10
# Max password age for board members (days)
GOVERNANCE_PASSWORD_MAX_DAYS=60

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
# Native Anthropic link in the chat chain (model for the Claude-first areas below).
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5
# Areas that try Claude first, then fall back to the free chain. Empty = off everywhere.
AI_CLAUDE_FIRST=sheq,helpdesk,crm,manufacturing,tender_pursuit,lms,content_marketing,ai_campaign_manager

# --- AI provider selection -------------------------------------------------
# Global default brain — "Groq first" for every module (routine work). Complex
# legal reasoning (policies/contracts/disciplinary) and tender qualify/evaluate/
# proposal are pinned to OpenAI in config/ai.php.
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Hybrid AI: "local" tier (cheap workhorse for routine, high-volume work)
# Any OpenAI-compatible endpoint. Set LOCAL_AI_ENABLED=true to turn it on.
#   Groq       BASE_URL=https://api.groq.com/openai/v1        MODEL=llama-3.3-70b-versatile
#   Together   BASE_URL=https://api.together.xyz/v1           MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
#   OpenRouter BASE_URL=https://openrouter.ai/api/v1          MODEL=meta-llama/llama-3.3-70b-instruct
#   Ollama     BASE_URL=http://127.0.0.1:11434/v1  (no key)   MODEL=qwen2.5:7b-instruct
LOCAL_AI_ENABLED=false
LOCAL_AI_BASE_URL=https://api.groq.com/openai/v1
LOCAL_AI_MODEL=llama-3.3-70b-versatile
LOCAL_AI_API_KEY=
LOCAL_AI_FALLBACK=openai        # if Groq fails/rate-limits, retry on this provider
# LOCAL_AI_MAX_TOKENS=4096
# LOCAL_AI_JSON=true            # set false only if the endpoint rejects JSON mode
AI_HELPDESK_PROVIDER=local      # helpdesk triage / replies on the cheap tier

# CRM builds its own client — defaults to the LOCAL_AI_* (Groq) settings above.
# Override only to isolate CRM on a different endpoint/key:
# CRM_AI_API_KEY=
# CRM_AI_BASE_URL=https://api.groq.com/openai/v1
# CRM_AI_MODEL=llama-3.3-70b-versatile
# CRM_AI_TRANSCRIBE_MODEL=whisper-large-v3

# Pin individual complex modules elsewhere if needed:
# AI_CONTRACTS_PROVIDER=openai
# AI_DISCIPLINARY_PROVIDER=openai

# WhatsApp Business API (Meta Cloud API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Laravel Reverb (real-time broadcasting)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Admin seeding ─────────────────────────────────────────────────────────────
# Passwords for seeded admin accounts. Leave blank locally and the seeder will
# generate a strong random password and print it once. SET these in production
# (never commit real values).
SEED_MASTER_ADMIN_PASSWORD=
SEED_MASTER_ADMIN_PHONE=
SEED_SUPPORT_PASSWORD=
SEED_SUPPORT_PHONE=

# ── Module licensing (signed licenses) ────────────────────────────────────────
# Empty = licensing dormant (all modules allowed). Generate keys with
# `php artisan license:keygen`; embed only the PUBLIC key here.
LICENSE_ENFORCE=true
LICENSE_PUBLIC_KEY=
# LICENSE_PATH=
# LICENSE_SERVER_ID=
# Remote validation / kill-switch (on client installs):
LICENSE_REMOTE=false
LICENSE_SERVER_URL=
LICENSE_REMOTE_SECRET=
LICENSE_GRACE_HOURS=72
# Set true ONLY on the one vendor-hosted authority instance:
LICENSE_AUTHORITY=false

# Tender Pursuit — auto-discovery feed (OCDS releases endpoint, e.g. SA eTenders API)
# Example: https://ocds-api.etenders.gov.za/api/OCDSReleases
TENDER_DISCOVERY_URL=

# ── Document storage ─────────────────────────────────────────────────────────
# Files are stored in Postgres, not on the filesystem, so a database dump is a
# document dump unless the bytes are encrypted before they get there.
#
# The key defaults to APP_KEY so an install works out of the box. Set this to
# separate document access from session and cookie access — APP_KEY tends to be
# the more widely shared of the two. Rotate by moving the current value to
# STORAGE_ENCRYPTION_KEY_PREVIOUS and setting a new one; existing files keep
# opening and nothing needs re-encrypting on the day.
STORAGE_ENCRYPTION_ENABLED=true
#STORAGE_ENCRYPTION_KEY=
#STORAGE_ENCRYPTION_KEY_PREVIOUS=

# Upload scanning. Type and magic-byte checks establish that a file is what it
# claims to be; they say nothing about whether it is safe. Point this at clamd
# in any installation holding real documents — 'none' runs structural checks
# only. When clamd is unreachable, 'block' refuses the upload, because a scanner
# that is down has not found nothing.
STORAGE_MALWARE_DRIVER=none
STORAGE_MALWARE_ON_UNAVAILABLE=block
#STORAGE_MALWARE_CLAMAV_ADDRESS=tcp://127.0.0.1:3310
